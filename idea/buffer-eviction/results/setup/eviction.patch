+			LWLockRelease(BufferEvictionPolicyLock);
+			pg_atomic_fetch_add_u64(&StrategyControl->stat_checks, checks);
+			return buf;
+		}
+		if (r == VICTIM_BUSY)
+			CountBusyBuffer(&trycounter);
+		else
+			trycounter = NBuffers;
+	}
