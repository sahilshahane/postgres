+static inline void
+CountBusyBuffer(int *trycounter)
+{
+	if (--(*trycounter) == 0)
+		ereport(ERROR,
+				errcode(ERRCODE_INSUFFICIENT_RESOURCES),
+				errmsg("could not find an unpinned shared buffer"));
+}
